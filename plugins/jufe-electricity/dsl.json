{
  "dslVersion": 1,
  "configGroups": [
    {
      "id": "room",
      "label": "寝室绑定",
      "submitLabel": "校验并添加寝室",
      "hint": "填写学号并依次选择「校区 → 楼栋 → 楼层 → 房间号」即可自动匹配电表，无需密码与代理，也无需记忆后台房间 ID。所选房间须已在微信「智慧江财 → 电费充值」中与该学号绑定。",
      "requiredKeys": [
        "username",
        "roomId"
      ],
      "fields": [
        {
          "key": "username",
          "label": "学号",
          "type": "TEXT",
          "required": true,
          "placeholder": "输入学号，如 22024xxxxx"
        },
        {
          "key": "campusId",
          "label": "校区",
          "type": "SEARCH_SELECT",
          "required": true,
          "placeholder": "点击选择校区",
          "optionsSource": {
            "request": {
              "method": "GET",
              "url": "https://wxcourse.jxufe.cn/electricity_charges/room/findCampusList",
              "headers": {
                "User-Agent": "Mozilla/5.0"
              }
            },
            "businessErrorRule": {
              "jsonPath": "code",
              "successValues": [
                "1"
              ],
              "messagePath": "message",
              "defaultMessage": "校区列表加载失败"
            },
            "listPath": "result",
            "valuePath": "id",
            "labelPath": "campus"
          }
        },
        {
          "key": "buildingId",
          "label": "楼栋",
          "type": "SEARCH_SELECT",
          "required": true,
          "dependsOn": "campusId",
          "placeholder": "点击选择楼栋",
          "optionsSource": {
            "request": {
              "method": "GET",
              "url": "https://wxcourse.jxufe.cn/electricity_charges/room/findBuildingList?campusId={{url:form.campusId}}",
              "headers": {
                "User-Agent": "Mozilla/5.0"
              }
            },
            "businessErrorRule": {
              "jsonPath": "code",
              "successValues": [
                "1"
              ],
              "messagePath": "message",
              "defaultMessage": "楼栋列表加载失败"
            },
            "listPath": "result",
            "valuePath": "id",
            "labelPath": "name"
          }
        },
        {
          "key": "floorId",
          "label": "楼层",
          "type": "SEARCH_SELECT",
          "required": true,
          "dependsOn": "buildingId",
          "placeholder": "点击选择楼层",
          "optionsSource": {
            "request": {
              "method": "GET",
              "url": "https://wxcourse.jxufe.cn/electricity_charges/room/findFloorListByBuilding?buildingId={{url:form.buildingId}}",
              "headers": {
                "User-Agent": "Mozilla/5.0"
              }
            },
            "businessErrorRule": {
              "jsonPath": "code",
              "successValues": [
                "1"
              ],
              "messagePath": "message",
              "defaultMessage": "楼层列表加载失败"
            },
            "listPath": "result",
            "valuePath": "id",
            "labelPath": "name"
          }
        },
        {
          "key": "roomId",
          "label": "房间号",
          "type": "SEARCH_SELECT",
          "required": true,
          "dependsOn": "floorId",
          "placeholder": "点击选择房间门牌号（如 01609）",
          "optionsSource": {
            "request": {
              "method": "GET",
              "url": "https://wxcourse.jxufe.cn/electricity_charges/room/findRoomListByFloor?floorId={{url:form.floorId}}",
              "headers": {
                "User-Agent": "Mozilla/5.0"
              }
            },
            "businessErrorRule": {
              "jsonPath": "code",
              "successValues": [
                "1"
              ],
              "messagePath": "message",
              "defaultMessage": "房间列表加载失败"
            },
            "listPath": "result",
            "valuePath": "id",
            "labelPath": "name"
          }
        },
        {
          "key": "roomName",
          "label": "寝室备注名（选填）",
          "type": "TEXT",
          "required": false,
          "placeholder": "留空则自动使用所选宿舍名称"
        },
        {
          "key": "alert_threshold",
          "label": "低电预警阈值（选填，默认 5 度）",
          "type": "TEXT",
          "required": false,
          "placeholder": "默认 5，如 5 / 10 / 20"
        }
      ],
      "onSubmit": {
        "mode": "http",
        "steps": [
          {
            "method": "GET",
            "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomBalance?username={{url:form.username}}&roomId={{url:form.roomId}}",
            "headers": {
              "User-Agent": "Mozilla/5.0"
            },
            "businessErrorRule": {
              "jsonPath": "code",
              "successValues": [
                "1"
              ],
              "messagePath": "message",
              "defaultMessage": "该学号与所选房间未绑定，请先在微信「智慧江财」电费小程序绑定一次"
            },
            "extractVars": {
              "roomNo": "{{res.result.roomNo}}",
              "unit": "{{res.result.unit}}"
            }
          }
        ],
        "saveFormKeys": [
          "username",
          "campusId",
          "campusId.label",
          "buildingId",
          "buildingId.label",
          "floorId",
          "floorId.label",
          "roomId",
          "roomId.label",
          "roomName",
          "alert_threshold"
        ],
        "extractToStorage": {
          "campus": "{{form.campusId.label}}",
          "buildingName": "{{form.buildingId.label}}",
          "floorName": "{{form.floorId.label}}",
          "doorNo": "{{form.roomId.label}}",
          "longName": "{{form.campusId.label}}{{form.buildingId.label}}{{form.floorId.label}}{{form.roomId.label}}",
          "roomNo": "{{res.result.roomNo|roomNo}}",
          "unit": "{{res.result.unit|unit}}"
        },
        "successMessage": "已校验并添加该寝室"
      }
    }
  ],
  "profiles": {
    "groupId": "room",
    "keyField": "username",
    "labelField": "roomName",
    "labelTemplate": "{{roomName|longName|roomNo}}",
    "subTemplate": "{{longName}} · 学号 {{username}}",
    "switcherTitle": "切换默认寝室",
    "maxCount": 10,
    "glanceRequest": {
      "method": "GET",
      "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomBalance?username={{url:storage.username}}&roomId={{url:storage.roomId}}",
      "headers": {
        "User-Agent": "Mozilla/5.0"
      }
    },
    "glanceValueTemplate": "{{res.result.balance}} 度",
    "glanceNumericPath": "result.balance",
    "businessErrorRule": {
      "jsonPath": "code",
      "successValues": [
        "1"
      ],
      "messagePath": "message",
      "defaultMessage": "该寝室余电查询失败"
    }
  },
  "thresholdAlert": {
    "metricLabel": "寝室余电",
    "unit": "度",
    "defaultThreshold": 5.0,
    "defaultMode": "notification",
    "defaultCheckIntervalHours": 6,
    "numericPath": "result.balance",
    "cooldownHours": 12
  },
  "glances": {
    "jufe_electricity_card": {
      "requiresGroupId": "room",
      "unboundSub": "填学号并点选楼栋房间，无需手填编号",
      "request": {
        "method": "GET",
        "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomBalance?username={{url:storage.username}}&roomId={{url:storage.roomId}}",
        "headers": {
          "User-Agent": "Mozilla/5.0"
        }
      },
      "businessErrorRule": {
        "jsonPath": "code",
        "successValues": [
          "1"
        ],
        "messagePath": "message",
        "defaultMessage": "寝室余电查询失败"
      },
      "title": "寝室电量",
      "chip": "{{storage.roomName|storage.buildingName|res.result.roomNo}}",
      "lowStateChip": "低电 ≤{{alertThreshold}}度",
      "readout": "{{res.result.balance}}",
      "readoutUnit": "度",
      "sub": "{{storage.longName|res.result.roomNo}} · 官方直连",
      "lowStateSub": "电量低于 {{alertThreshold}} 度，请及时充值 · {{storage.longName|res.result.roomNo}}",
      "details": [
        {
          "label": "宿舍",
          "value": "{{storage.roomName|storage.longName|res.result.roomNo}}"
        },
        {
          "label": "电表号",
          "value": "{{res.result.roomNo}}"
        },
        {
          "label": "位置",
          "value": "{{storage.campus|'-'}} {{storage.buildingName}}"
        },
        {
          "label": "预警阈值",
          "value": "≤ {{alertThreshold}} 度"
        },
        {
          "label": "提醒方式",
          "value": "{{alertModeLabel}}"
        },
        {
          "label": "已管寝室",
          "value": "共 {{profileCount}} 间"
        }
      ],
      "state": "IDLE",
      "tapPageId": "overview"
    }
  },
  "detailPages": [
    {
      "id": "overview",
      "title": "寝室电量",
      "navLabel": "概况",
      "navIcon": "OVERVIEW",
      "requiresGroupId": "room",
      "headerAction": {
        "label": "添加寝室",
        "commandId": "profile.add",
        "style": "PRIMARY"
      },
      "note": "数据直连江财官方微信缴费接口（wxcourse.jxufe.cn），全链路只读、无需密码与代理；点击列表任意寝室可设默认、改备注或删除。",
      "steps": [
        {
          "method": "GET",
          "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomBalance?username={{url:storage.username}}&roomId={{url:storage.roomId}}",
          "headers": {
            "User-Agent": "Mozilla/5.0"
          },
          "businessErrorRule": {
            "jsonPath": "code",
            "successValues": [
              "1"
            ],
            "messagePath": "message",
            "defaultMessage": "寝室余电查询失败"
          },
          "extractVars": {
            "balance": "{{res.result.balance}}",
            "roomNo": "{{res.result.roomNo}}"
          }
        },
        {
          "method": "GET",
          "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomChargesRecord?username={{url:storage.username}}&roomId={{url:storage.roomId}}&pageNum=1&pageSize=10",
          "headers": {
            "User-Agent": "Mozilla/5.0"
          },
          "optional": true,
          "extractVars": {
            "lastChargeMoney": "{{cents:res.result.data.0.money}}",
            "lastChargeTime": "{{date_cn:res.result.data.0.createTime}}",
            "lastChargePayType": "{{res.result.data.0.payTypeName|res.result.data.0.payType}}",
            "allCount": "{{res.result.allCount}}"
          },
          "extractArrayCentsSum": {
            "recentChargeTotal": "result.data.*.money"
          },
          "extractArrayCount": {
            "recentChargeCount": "result.data"
          }
        }
      ],
      "sections": [
        {
          "type": "kpi",
          "highlight": {
            "chip": "{{storage.roomName|storage.buildingName|'当前寝室'}} · {{alertStatusLabel}}",
            "lowChip": "电量偏低 · 低于 {{alertThreshold}} 度",
            "readout": "{{res.result.balance|balance}}",
            "unit": "度",
            "side": [
              {
                "label": "位置",
                "value": "{{storage.longName|res.result.roomNo}}"
              },
              {
                "label": "预警",
                "value": "≤ {{alertThreshold}} 度 · {{alertModeLabel}}"
              }
            ]
          },
          "items": [
            {
              "label": "最近充值",
              "value": "¥{{lastChargeMoney|'—'}}",
              "unit": "{{lastChargeTime|'暂无记录'}}"
            },
            {
              "label": "近 10 笔累计",
              "value": "¥{{recentChargeTotal|'0.00'}}",
              "unit": "共 {{allCount|'0'}} 笔"
            },
            {
              "label": "电表编号",
              "value": "{{res.result.roomNo|roomNo}}",
              "unit": "房间 ID {{storage.roomId}}"
            },
            {
              "label": "后台巡检",
              "value": "{{alertIntervalLabel}}",
              "unit": "{{alertModeLabel}}"
            }
          ]
        },
        {
          "type": "records",
          "title": "全部寝室实时余电",
          "source": "profiles",
          "emptyText": "暂未添加寝室"
        },
        {
          "type": "records",
          "title": "当前寝室档案",
          "rows": [
            {
              "id": "dorm_location",
              "title": "{{storage.longName|storage.roomName|res.result.roomNo}}",
              "sub": "校区：{{storage.campus|'未知'}} · 楼栋：{{storage.buildingName|'-'}} · 学号：{{storage.username}}"
            },
            {
              "id": "last_channel",
              "title": "最近充值方式：{{lastChargePayType|'暂无充值记录'}}",
              "sub": "近 10 笔合计 ¥{{recentChargeTotal|'0.00'}}（累计 {{allCount|'0'}} 笔）"
            },
            {
              "id": "source_info",
              "title": "官方只读 HTTPS 直连",
              "sub": "wxcourse.jxufe.cn · 无需密码与学校授权",
              "badge": "官方直连",
              "badgeTone": "POSITIVE"
            }
          ]
        }
      ]
    },
    {
      "id": "records",
      "title": "充值记录",
      "navLabel": "流水",
      "navIcon": "STATS",
      "requiresGroupId": "room",
      "steps": [
        {
          "method": "GET",
          "url": "https://wxcourse.jxufe.cn/electricity_charges/api/charges/findRoomChargesRecord?username={{url:storage.username}}&roomId={{url:storage.roomId}}&pageNum=1&pageSize=20",
          "headers": {
            "User-Agent": "Mozilla/5.0"
          },
          "businessErrorRule": {
            "jsonPath": "code",
            "successValues": [
              "1"
            ],
            "messagePath": "message",
            "defaultMessage": "充值记录查询失败"
          },
          "extractArrayCentsSum": {
            "recentChargeTotal": "result.data.*.money"
          },
          "extractVars": {
            "allCount": "{{res.result.allCount}}"
          }
        }
      ],
      "sections": [
        {
          "type": "kpi",
          "items": [
            {
              "label": "近 20 笔合计",
              "value": "¥{{recentChargeTotal|'0.00'}}",
              "unit": "北京时间"
            },
            {
              "label": "历史总笔数",
              "value": "{{allCount|'0'}}",
              "unit": "笔"
            }
          ]
        },
        {
          "type": "records",
          "title": "充值流水明细",
          "listPath": "result.data",
          "rowIdPath": "id",
          "titleTemplate": "{{res.remark}}",
          "subTemplate": "{{datetime_cn:res.createTime}} · 订单 {{res.orderNo}}",
          "amountTemplate": "+¥{{cents:res.money}}",
          "tone": "IN",
          "badgeTemplate": "{{res.payTypeName|res.payType}}",
          "badgeTone": "POSITIVE",
          "emptyText": "暂无充值记录"
        }
      ]
    },
    {
      "id": "manage",
      "title": "寝室与预警",
      "navLabel": "管理",
      "navIcon": "DEVICES",
      "requiresGroupId": "room",
      "headerAction": {
        "label": "添加寝室",
        "commandId": "profile.add",
        "style": "PRIMARY"
      },
      "note": "低电通知与系统闹钟依赖系统通知权限；如需 App 在后台自动定时查电，请把 CampusHub 加入电池优化白名单。",
      "sections": [
        {
          "type": "records",
          "title": "已添加寝室（点击切换 / 改备注 / 删除）",
          "source": "profiles",
          "emptyText": "暂未添加寝室，点击右上角「添加寝室」"
        },
        {
          "type": "form",
          "title": "低电量提醒设置",
          "fields": [
            {
              "key": "alert_mode",
              "label": "提醒方式",
              "type": "SELECT",
              "options": [
                {
                  "label": "仅卡片标红",
                  "value": "off"
                },
                {
                  "label": "通知栏提醒",
                  "value": "notification"
                },
                {
                  "label": "系统闹钟响铃",
                  "value": "alarm"
                }
              ]
            },
            {
              "key": "alert_threshold",
              "label": "低电预警阈值",
              "type": "SELECT",
              "options": [
                {
                  "label": "3 度",
                  "value": "3"
                },
                {
                  "label": "5 度（默认）",
                  "value": "5"
                },
                {
                  "label": "10 度",
                  "value": "10"
                },
                {
                  "label": "15 度",
                  "value": "15"
                },
                {
                  "label": "20 度",
                  "value": "20"
                },
                {
                  "label": "30 度",
                  "value": "30"
                },
                {
                  "label": "50 度",
                  "value": "50"
                }
              ]
            },
            {
              "key": "alert_check_interval",
              "label": "后台巡检频率",
              "type": "SELECT",
              "options": [
                {
                  "label": "仅打开 App 时",
                  "value": "0"
                },
                {
                  "label": "每 6 小时",
                  "value": "6"
                },
                {
                  "label": "每 12 小时",
                  "value": "12"
                },
                {
                  "label": "每天一次",
                  "value": "24"
                }
              ]
            }
          ]
        },
        {
          "type": "records",
          "title": "自定义阈值与权限",
          "rows": [
            {
              "id": "custom_threshold",
              "title": "自定义低电阈值",
              "sub": "当前阈值：{{alertThreshold}} 度（点击可输入 0.1～500 任意度数）",
              "badge": "{{alertThreshold}} 度",
              "actions": [
                {
                  "id": "alert.set_threshold",
                  "label": "输入自定义度数",
                  "kind": "PROMPT_TEXT",
                  "prompt": "低电阈值（度）"
                }
              ]
            }
          ]
        },
        {
          "type": "records",
          "title": "权限检查",
          "source": "alert_permissions",
          "emptyText": ""
        }
      ],
      "actions": [
        {
          "label": "测试提醒",
          "commandId": "alert.test",
          "style": "SECONDARY"
        }
      ]
    }
  ]
}
